{
  "name": "deckshoes",
  "version": "1.0.0-alpha.3",
  "description": "A lightweight, fully typed library for playing cards: decks, shoes, shuffling, dealing and more.",
  "keywords": [
    "cards",
    "playing-cards",
    "deck",
    "shoe",
    "shuffle",
    "deal",
    "poker",
    "blackjack",
    "card-game"
  ],
  "homepage": "https://github.com/SimpleProgrammingAU/deckshoes#readme",
  "bugs": {
    "url": "https://github.com/SimpleProgrammingAU/deckshoes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimpleProgrammingAU/deckshoes.git"
  },
  "license": "MIT",
  "author": "Simple Programming <hi@simpleprogramming.com.au>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench --run --reporter=default",
    "build": "tsdown",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage && pnpm docs:build && pnpm build && pnpm check:package && pnpm size && pnpm smoke && pnpm knip",
    "check:package": "publint && attw --pack --profile esm-only",
    "coverage": "pnpm doctest:gen && vitest run --coverage",
    "dev": "tsdown --watch",
    "docs:build": "typedoc",
    "doctest:gen": "node scripts/doctest.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "release": "pnpm build && node scripts/release.ts",
    "size": "size-limit",
    "smoke": "node scripts/smoke.ts",
    "test": "pnpm doctest:gen && vitest run",
    "test:watch": "pnpm doctest:gen && vitest",
    "typecheck": "pnpm doctest:gen && tsc --noEmit && tsc --noEmit -p tsconfig.lib.json",
    "version-packages": "changeset version && node scripts/stamp-since.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.4",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
